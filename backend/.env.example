# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL / Supabase Database Connection
# Format: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_pantry

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_smart_pantry_2026
JWT_EXPIRES_IN=7d

# Google Gemini API Key for OCR & Recipe Generation
GEMINI_API_KEY=your_gemini_api_key_here
